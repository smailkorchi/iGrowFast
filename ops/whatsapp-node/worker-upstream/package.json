{
  "name": "@wa-mancer/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp Mancer outbound dispatcher + webhook receiver. Drains outbound_queue per number with humanized pacing, ingests Evolution webhooks into Supabase.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@supabase/supabase-js": "^2.45.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
