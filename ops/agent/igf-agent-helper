#!/usr/bin/env python3
"""igf-agent-helper — root-side helper for the backup agent (sudoers-scoped).

The unprivileged agent may run exactly two verbs via sudo:
  check-admin <uuid>  -> prints "true"/"false": is <uuid> an active backup_admin
  status-json         -> one JSON blob: pgbackrest, archiver, disk, heartbeats,
                         drill freshness, job log tails, unit activity
This file is the privilege boundary: validate everything, execute only
fixed commands, never echo secrets.
"""
import json
import os
import re
import subprocess
import sys
import glob
import time

UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
PSQL = ["docker", "exec", "-u", "postgres", "supabase-db",
        "psql", "-U", "supabase_admin", "-d", "postgres", "-At", "-c"]


def run(cmd, timeout=20, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)


def check_admin(uuid: str) -> int:
    if not UUID_RE.match(uuid):
        print("false")
        return 1
    q = ("select coalesce((select backup_admin and coalesce(active,false) "
         f"from public.users where id = '{uuid}'), false)")
    try:
        out = run(PSQL + [q])
        print("true" if out.stdout.strip() == "t" else "false")
        return 0
    except Exception:
        print("false")
        return 1


def rclone_env(path: str) -> dict:
    env = dict(os.environ, RCLONE_CONFIG="/dev/null")
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k] = v
    return env


def heartbeats() -> dict:
    """Read all heartbeat JSONs this box can see (own via r2db, toolbox via r2wd)."""
    out = {}
    now = time.time()
    sources = [
        ("/root/.config/igf-backup/r2-db-backups.env", "r2db:igf-db-backups/heartbeat/vmi3390870/"),
        ("/root/.config/igf-backup/r2-hb.env", "vmi3414204"),  # toolbox, via r2wd
        ("/root/.config/igf-backup/r2-hb.env", "vmi3418398"),  # whatsapp box, via r2wd
    ]
    for envf, remote in sources:
        try:
            env = rclone_env(envf)
            if not remote.startswith("r2"):
                remote = f"r2wd:{env.get('IGF_WD_BUCKET','')}/heartbeat/{remote}/"
            ls = run(["rclone", "lsjson", remote], env=env, timeout=30)
            for item in json.loads(ls.stdout or "[]"):
                name = item["Name"]
                cat = run(["rclone", "cat", remote + name], env=env, timeout=30)
                hb = json.loads(cat.stdout)
                age = int(now - hb.get("ts", 0))
                out[f"{hb.get('host','?')}/{hb.get('job', name)}"] = {
                    "iso": hb.get("iso"), "age_sec": age,
                    "max_age_sec": hb.get("max_age_sec"),
                    "fresh": age <= int(hb.get("max_age_sec", 0)),
                }
        except Exception as e:
            out[f"_error_{os.path.basename(envf)}"] = str(e.__class__.__name__)
    return out


def status_json() -> int:
    data = {}
    try:
        info = run(["docker", "exec", "-u", "postgres", "supabase-db", "pgbackrest",
                    "--config=/etc/postgresql-custom/pgbackrest.conf", "--stanza=igf",
                    "--output=json", "info"], timeout=60)
        j = json.loads(info.stdout)[0]
        data["pitr"] = {
            "status": j["status"]["message"],
            "wal_min": j["archive"][0]["min"], "wal_max": j["archive"][0]["max"],
            "backups": [{
                "type": b.get("type"), "label": b.get("label"),
                "start": b.get("timestamp", {}).get("start"),
                "stop": b.get("timestamp", {}).get("stop"),
                "db_bytes": b.get("info", {}).get("size"),
                # incrementals report only their delta in the repo, fulls report size
                "repo_bytes": b.get("info", {}).get("repository", {}).get(
                    "size", b.get("info", {}).get("repository", {}).get("delta")),
                "error": b.get("error"),
            } for b in j["backup"][-6:]],
        }
    except Exception as e:
        data["pitr"] = {"error": e.__class__.__name__}
    try:
        arch = run(PSQL + ["select archived_count||'|'||failed_count||'|'||"
                           "coalesce(last_archived_time::text,'') from pg_stat_archiver"])
        a, f, t = arch.stdout.strip().split("|")
        data["archiver"] = {"archived": int(a), "failed": int(f), "last": t}
    except Exception as e:
        data["archiver"] = {"error": e.__class__.__name__}
    try:
        st = os.statvfs("/")
        data["disk"] = {"avail_bytes": st.f_bavail * st.f_frsize,
                        "used_pct": round(100 * (1 - st.f_bavail / st.f_blocks), 1)}
    except Exception:
        pass
    data["heartbeats"] = heartbeats()
    drill = data["heartbeats"].get("vmi3390870/restore-drill")
    data["drill_fresh"] = bool(drill and drill["fresh"])
    tails = {}
    for path in sorted(glob.glob("/var/log/igf-backup/*.log")):
        try:
            with open(path, "rb") as fh:
                fh.seek(max(-4096, -os.path.getsize(path)), 2)
                lines = fh.read().decode(errors="replace").strip().splitlines()
                tails[os.path.basename(path)] = lines[-1] if lines else ""
        except OSError:
            pass
    data["log_tails"] = tails
    units = ["igf-pgdump", "igf-pgbackrest-incr", "igf-pgbackrest-full", "igf-restic",
             "igf-storage-mirror", "igf-pgbackrest-verify", "igf-restore-drill", "igf-restore"]
    act = {}
    for u in units:
        try:
            # oneshot units read "activating" while ExecStart runs, "failed" on error,
            # "inactive"/"dead" when done. The frontend maps these to running/failed/idle.
            act[u] = run(["systemctl", "is-active", f"{u}.service"], timeout=5).stdout.strip()
        except Exception:
            act[u] = "unknown"
    data["units"] = act
    data["generated"] = int(time.time())
    print(json.dumps(data, separators=(",", ":")))
    return 0


TARGET_RE = re.compile(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}[+-]\d{2}$")


def restore_plan(target: str) -> int:
    cmd = ["/usr/local/bin/igf-restore-plan.sh"]
    if target and target != "-":
        if not TARGET_RE.match(target):
            print(json.dumps({"error": "bad_target"})); return 1
        cmd += ["--target", target]
    out = run(cmd, timeout=60)
    sys.stdout.write(out.stdout)
    return out.returncode


def restore_start(target: str, confirm: str) -> int:
    """Write the restore request and start the fixed unit. The execute script
    itself enforces the arm gate + drill freshness + confirm match; without the
    RESTORE_ARMED flag it runs in the SAFE validate-into-clone mode."""
    if target and target != "-" and not TARGET_RE.match(target):
        print(json.dumps({"error": "bad_target"})); return 1
    armed = os.path.exists("/etc/igf-backup-agent/RESTORE_ARMED")
    mode = "swap" if armed else "validate"
    os.makedirs("/run/igf-restore", exist_ok=True)
    req = {"target": "" if target == "-" else target,
           "confirm": "" if confirm == "-" else confirm, "mode": mode}
    with open("/run/igf-restore/request.json", "w") as f:
        json.dump(req, f)
    os.chmod("/run/igf-restore/request.json", 0o600)
    r = run(["systemctl", "start", "--no-block", "igf-restore.service"], timeout=15)
    if r.returncode != 0:
        print(json.dumps({"error": "unit_start_failed"})); return 1
    note = ("restauration en direct lancée" if armed else
            "validation du point de restauration (le serveur n'est pas armé pour l'écrasement en direct)")
    print(json.dumps({"mode": mode, "note": note}))
    return 0


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "check-admin":
        return check_admin(sys.argv[2])
    if len(sys.argv) == 2 and sys.argv[1] == "status-json":
        return status_json()
    if len(sys.argv) == 3 and sys.argv[1] == "restore-plan":
        return restore_plan(sys.argv[2])
    if len(sys.argv) == 4 and sys.argv[1] == "restore-start":
        return restore_start(sys.argv[2], sys.argv[3])
    print("usage: igf-agent-helper check-admin <uuid> | status-json | "
          "restore-plan <target|-> | restore-start <target|-> <confirm|->", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
