---
/**
 * Hero visual: a scatter of ten disconnected tools collapses into one
 * workspace — and the workspace STAYS. It is the resolved end-state, so it
 * must dominate the column, not float in it. The earlier version left the
 * column blank because the resolved panel was small and the collapse could
 * halt mid-run; this one lands a full product surface and holds it.
 *
 * Brand names are TEXT ONLY, nominative, depicting the problem. No logos —
 * no licence to display any, and the footer's non-endorsement line qualifies
 * the text. Same fixed-canvas + transform:scale technique as the demos.
 */

const tabs = [
  { label: 'WhatsApp', x: 24, y: 22 },
  { label: 'Google Sheets', x: 300, y: 8 },
  { label: 'Coliaty', x: 590, y: 28 },
  { label: 'Meta Ads', x: 150, y: 96 },
  { label: 'Vitex', x: 470, y: 92 },
  { label: 'Commandes', x: 40, y: 178 },
  { label: 'Digylog', x: 620, y: 158 },
  { label: 'Comptabilité', x: 250, y: 200 },
  { label: 'Stock', x: 500, y: 214 },
  { label: 'Commissions', x: 90, y: 286 },
];

// The resolved workspace: an order table that reads as the real product.
const rows = [
  { name: 'Salma B.', city: 'Casablanca', status: 'Livré', tone: 'ok' },
  { name: 'Youssef E.', city: 'Rabat', status: 'En route', tone: 'go' },
  { name: 'Nadia K.', city: 'Agadir', status: 'Confirmé', tone: 'warm' },
  { name: 'Amine M.', city: 'Marrakech', status: 'Livré', tone: 'ok' },
  { name: 'Hafsa R.', city: 'Tanger', status: 'Retour', tone: 'muted' },
];
---

<div class="hero-stage-frame" data-w="760" data-h="520" style="aspect-ratio:760/520">
  <div class="hero-stage" data-w="760" style="width:760px;height:520px">
    <!-- scattered mess -->
    <div class="tabs" id="hero-tabs">
      {
        tabs.map((t, i) => (
          <div class="tab" data-i={i} style={`left:${t.x}px; top:${t.y}px`}>
            <span class="dot" />
            <span class="tab-label">{t.label}</span>
          </div>
        ))
      }
    </div>

    <!-- resolved workspace -->
    <div class="one" id="hero-one">
      <div class="one-bar">
        <span class="one-mark" />
        <span class="one-title">iGrowFast</span>
        <span class="one-tab is-on">Commandes</span>
        <span class="one-tab">Inbox</span>
        <span class="one-tab">Livraisons</span>
        <span class="one-grow" />
        <span class="one-avatar">K</span>
      </div>
      <div class="one-body">
        <aside class="one-side">
          <span class="side-item is-on"><i></i>Tableau de bord</span>
          <span class="side-item"><i></i>Commandes</span>
          <span class="side-item"><i></i>Inbox</span>
          <span class="side-item"><i></i>Livraisons</span>
          <span class="side-item"><i></i>Campagnes</span>
          <span class="side-item"><i></i>Paiements</span>
          <span class="side-sep" />
          <span class="side-stat"><b>1 284</b>commandes</span>
        </aside>
        <div class="one-main">
          <div class="one-toolbar">
            <span class="tb-search">Rechercher une commande</span>
            <span class="tb-btn">Exporter</span>
          </div>
          <div class="one-table">
            <div class="tr th">
              <span>Client</span><span>Ville</span><span>Statut</span>
            </div>
            {
              rows.map((r) => (
                <div class="tr">
                  <span class="td-name"><i class="av" />{r.name}</span>
                  <span class="td-city">{r.city}</span>
                  <span class="td-status">
                    <i class={`st st-${r.tone}`} />
                    {r.status}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-stage-frame {
    position: relative;
    width: 100%;
  }
  .hero-stage {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: top left;
    user-select: none;
  }

  /* ── scattered tabs ── */
  .tab {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: 0 1px 2px rgba(20, 20, 19, 0.04), 0 8px 20px rgba(20, 20, 19, 0.06);
    white-space: nowrap;
    will-change: transform;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--mid);
    flex-shrink: 0;
  }
  .tab-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  /* ── resolved workspace ── */
  .one {
    position: absolute;
    inset: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(20, 20, 19, 0.04), 0 30px 60px -24px rgba(20, 20, 19, 0.22);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .one-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--canvas);
  }
  .one-mark {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .one-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-right: 8px;
  }
  .one-tab {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .one-tab.is-on {
    background: var(--ink);
    color: var(--canvas);
  }
  .one-grow {
    flex: 1;
  }
  .one-avatar {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 11px;
    font-weight: 600;
    display: grid;
    place-items: center;
  }

  .one-body {
    flex: 1;
    display: grid;
    grid-template-columns: 172px 1fr;
    min-height: 0;
  }
  .one-side {
    border-right: 1px solid var(--line-soft);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--canvas);
  }
  .side-item {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
    padding: 7px 10px;
    border-radius: 8px;
  }
  .side-item i {
    width: 13px;
    height: 13px;
    border-radius: 4px;
    background: var(--line);
    flex-shrink: 0;
  }
  .side-item.is-on {
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .side-item.is-on i {
    background: var(--accent);
  }
  .side-sep {
    height: 1px;
    background: var(--line-soft);
    margin: 10px 4px;
  }
  .side-stat {
    display: flex;
    flex-direction: column;
    padding: 0 10px;
    font-size: 11px;
    color: var(--mid);
  }
  .side-stat b {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.1;
  }

  .one-main {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .one-toolbar {
    display: flex;
    gap: 8px;
  }
  .tb-search {
    flex: 1;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 7px 11px;
    font-size: 12px;
    color: var(--mid);
  }
  .tb-btn {
    background: var(--ink);
    color: var(--canvas);
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 600;
  }
  .one-table {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .tr {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    align-items: center;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 12.5px;
  }
  .tr:last-child {
    border-bottom: 0;
  }
  .tr.th {
    background: var(--canvas);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .td-name {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 500;
    color: var(--ink);
  }
  .td-name .av {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--accent-soft);
    flex-shrink: 0;
  }
  .td-city {
    color: var(--muted);
  }
  .td-status {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--ink);
  }
  .st {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .st-ok { background: var(--green); }
  .st-go { background: var(--cool); }
  .st-warm { background: var(--accent); }
  .st-muted { background: var(--mid); }

  @media (prefers-reduced-motion: reduce) {
    .tabs { display: none; }
    .one { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const frame = document.querySelector('.hero-stage-frame') as HTMLElement | null;
  const stage = document.querySelector('.hero-stage') as HTMLElement | null;
  if (frame && stage) {
    const fit = () => {
      const w = parseInt(frame.dataset.w!, 10);
      const h = parseInt(frame.dataset.h!, 10);
      frame.style.aspectRatio = `${w} / ${h}`;
      stage.style.transform = `scale(${frame.clientWidth / w})`;
    };
    fit();
    new ResizeObserver(fit).observe(frame);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = gsap.utils.toArray<HTMLElement>('.tab');
    const one = document.querySelector('.one') as HTMLElement;

    if (reduced) {
      gsap.set(one, { autoAlpha: 1, scale: 1 });
    } else {
      gsap.set(one, { autoAlpha: 0, scale: 0.96, transformOrigin: '50% 55%' });

      const tl = gsap.timeline({ delay: 0.3 });

      // 1 — the mess arrives, scattered.
      tl.from(tabs, {
        autoAlpha: 0,
        scale: 0.82,
        y: 16,
        duration: 0.5,
        ease: 'power2.out',
        stagger: { each: 0.05, from: 'random' },
      });

      // 2 — it sits there. The beat is the point: this is the "ugh".
      tl.to({}, { duration: 0.7 });

      // 3 — everything converges on the centre of the stage and vanishes.
      //     x/y computed per-target from its real layout position, so it works
      //     regardless of where each tab started. No junk pre-tween.
      tl.to(tabs, {
        x: (_i: number, t: HTMLElement) => 380 - (t.offsetLeft + t.offsetWidth / 2),
        y: (_i: number, t: HTMLElement) => 260 - (t.offsetTop + t.offsetHeight / 2),
        scale: 0.3,
        autoAlpha: 0,
        duration: 0.7,
        ease: 'power3.inOut',
        stagger: { each: 0.028, from: 'edges' },
      });

      // 4 — one workspace remains, and stays. This is the resolved state.
      tl.to(
        one,
        { autoAlpha: 1, scale: 1, duration: 0.65, ease: 'power3.out' },
        '-=0.3'
      );
    }
  }
</script>
